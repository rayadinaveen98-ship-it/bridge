{
  "name": "@bridge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bridge server-side HTTP/auth foundation; PostgreSQL integration pending",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "node src/start.mjs",
    "test:v2:contracts": "node --test tests/v2/contracts/lifecycle.test.mjs tests/v2/contracts/retention.test.mjs tests/v2/access_matrix.test.mjs tests/v2/migration_inventory.test.mjs",
    "test:policy": "node --test tests/policy/policy.test.mjs tests/policy/security.test.mjs",
    "test:v2:migrations": "node --test tests/v2/migrations/rehearsal.test.mjs",
    "test:v2:sessions": "node --test tests/v2/sessions/clock.test.mjs",
    "test:v2:sessions:db": "node --test tests/v2/sessions/postgres.test.mjs",
    "test:v2:connections": "node --test tests/v2/connections/keep.test.mjs",
    "test:v2:connections:db": "node --test tests/v2/connections/postgres.test.mjs",
    "test:v2:direct": "node --test tests/v2/direct/lifecycle.test.mjs",
    "test:v2:direct:db": "node --test tests/v2/direct/postgres.test.mjs",
    "test:v2:messaging": "node --test tests/v2/messaging/policy.test.mjs",
    "test:v2:messaging:db": "node --test tests/v2/messaging/postgres.test.mjs",
    "test:v2:private-schema": "node --test tests/v2/private_messaging/schema.test.mjs && node --test tests/v2/private_messaging/backup_restore.test.mjs",
    "test:v2:private-crypto": "node --test tests/v2/private_messaging/crypto.test.mjs tests/v2/private_messaging/key_contract.test.mjs",
    "test:v2:private-accept:db": "node --test tests/v2/private_messaging/b2_accept.test.mjs && node --test tests/v2/private_messaging/b2_races.test.mjs",
    "test:v2:private-delivery:db": "node --test tests/v2/private_messaging/b2_delivery.test.mjs && node --test tests/v2/private_messaging/b2_delivery_races.test.mjs",
    "test:v2:compatibility": "node --test tests/v2/compatibility/route_matrix.test.mjs tests/v2/compatibility/response_contract.test.mjs",
    "test:v2:identity": "node --test tests/v2/identity/signed_subject.test.mjs",
    "test:v2:identity:db": "node --test tests/v2/identity/postgres_subject.test.mjs && node --test tests/v2/identity/race_subject.test.mjs",
    "test:v2:atomic-private:db": "node --test tests/v2/identity/atomic_write.test.mjs && node --test tests/v2/identity/atomic_delivery.test.mjs && node --test tests/v2/identity/atomic_races.test.mjs"
  },
  "dependencies": {
    "pg": "^8.13.0"
  }
}
