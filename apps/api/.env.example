# Configuration placeholders only. NEVER commit real values.
BRIDGE_DATABASE_URL=postgresql://bridge_test:replace-me@127.0.0.1:5432/bridge_test
BRIDGE_AUTH_PUBLIC_KEY_FILE=/absolute/path/to/test-rsa-public.pem
BRIDGE_AUTH_ISSUER=bridge-internal-test
BRIDGE_AUTH_AUDIENCE=bridge-api
BRIDGE_BIND_HOST=127.0.0.1
BRIDGE_PORT=8787

# Disabled by default. Enables LOCAL synthetic test account login only.
BRIDGE_ALLOW_LAB_LOGIN=0
BRIDGE_LAB_PRIVATE_KEY_FILE=/absolute/path/to/.bridge-private-lab/lab-private.pem
# Never commit generated private keys or synthetic passphrases.
